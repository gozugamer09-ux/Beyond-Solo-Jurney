  "perk.beyondsolo.bone_ward.desc": "casting a skill shields you and the players around you (at most every 10 s)",
  "perk.beyondsolo.prism_charge": "Prism Charge",
  "perk.beyondsolo.prism_charge.desc": "a melee hit while sprinting strikes 30% harder and knocks back (every 4 s)",
  "perk.beyondsolo.tower_guard": "Tower Guard",
  "perk.beyondsolo.tower_guard.desc": "20% less damage from the front",
  "perk.beyondsolo.pyre_burst": "Pyre Burst",
  "perk.beyondsolo.pyre_burst.desc": "foes you kill burst into flame, scorching everything around them",
  "perk.beyondsolo.hollow_echo": "Hollow Echo",
  "perk.beyondsolo.hollow_echo.desc": "your spells have a 20% chance to echo for 35% of their damage a moment later",
  "perk.beyondsolo.moonlit_hunt": "Moonlit Hunt",
  "perk.beyondsolo.moonlit_hunt.desc": "your arrows hit 20% harder in the dark; every 5th arrow that lands looses a moon fang (magic and bleeding)",
  "perk.beyondsolo.saints_grace": "Saint's Grace",
  "perk.beyondsolo.saints_grace.desc": "a player near you who falls under 35% health is healed for 30% of it (every 45 s)",
  "perk.beyondsolo.ashen_bulwark": "Ashen Bulwark",
  "perk.beyondsolo.ashen_bulwark.desc": "25% less damage from the front; taking a hit draws the foes around you onto you (every 5 s)",
  "perk.beyondsolo.cradle_silk": "Cradle Silk",
  "perk.beyondsolo.cradle_silk.desc": "casting a skill heals the most hurt player near you and hardens them for 3 s (every 8 s)",
  "perk.beyondsolo.alphas_howl": "Alpha's Howl",
  "perk.beyondsolo.alphas_howl.desc": "every kill gives you Strength and Speed for 4 s",
  "perk.beyondsolo.vanguard_cleave": "Vanguard Cleave",
  "perk.beyondsolo.vanguard_cleave.desc": "every 3rd melee hit cleaves the foes in front of you for half its damage",
  "perk.beyondsolo.storm_sigil": "Storm Sigil",
  "perk.beyondsolo.storm_sigil.desc": "your spells have a 25% chance to arc lightning for 30% of their damage",
  "perk.beyondsolo.frostbite_arrows": "Frostbite Arrows",
  "perk.beyondsolo.frostbite_arrows.desc": "your arrows build frostbite",
  "perk.beyondsolo.rime_bloom": "Rime Bloom",
  "perk.beyondsolo.rime_bloom.desc": "casting a skill frostbites the foes within 5 blocks and heals the players around you (every 6 s)",
  "perk.beyondsolo.empress_venom": "Empress Venom",
  "perk.beyondsolo.empress_venom.desc": "your melee hits build heavy venom; a poisoned foe you kill spills it onto everything near it",
  "perk.beyondsolo.oath_of_iron": "Oath of Iron",
  "perk.beyondsolo.oath_of_iron.desc": "25% less damage while sneaking or blocking; players within 6 blocks of you take 10% less",
  "perk.beyondsolo.starbinding": "Starbinding",
  "perk.beyondsolo.starbinding.desc": "every 8 s a star thread mends the most hurt player near you (Regeneration II)",
  "perk.beyondsolo.ashfall": "Ashfall",
  "perk.beyondsolo.ashfall.desc": "your arrows build burning; critical arrows burst into flame around the target",
  "perk.beyondsolo.phantom_blade": "Phantom Blade",
  "perk.beyondsolo.phantom_blade.desc": "after a kill or a combat roll, a phantom blade echoes your next melee strike for half its damage and crimson",
  "perk.beyondsolo.arcane_cascade": "Arcane Cascade",
  "perk.beyondsolo.arcane_cascade.desc": "each skill cast adds a stack for 6 s (+5% spell damage, up to 5); the fifth releases an arcane nova",
  "perk.beyondsolo.dragons_blood": "Dragon's Blood",
  "perk.beyondsolo.dragons_blood.desc": "your melee hits build burning; under half health they hit 20% harder and heal you for 5% of the damage",
  "perk.beyondsolo.warlords_fury": "Warlord's Fury",
  "perk.beyondsolo.warlords_fury.desc": "every kill adds a stack of fury for 10 s: +6% damage each, up to 5",
  "perk.beyondsolo.shadow_veil": "Shadow Veil",
  "perk.beyondsolo.shadow_veil.desc": "a 15% chance to slip a hit entirely; your next strike within 3 s hits 60% harder and makes the foe bleed",
  "perk.beyondsolo.arcane_overflow": "Arcane Overflow",
  "perk.beyondsolo.arcane_overflow.desc": "every 4th skill cast within 20 s overflows into a starlight nova around you",
  "perk.beyondsolo.sanctuary": "Sanctuary",
  "perk.beyondsolo.sanctuary.desc": "you and the players within 8 blocks take 15% less damage; under 40% health you shield everyone around you (every 60 s)",
  "perk.beyondsolo.overflowing_grace": "Overflowing Grace",
  "perk.beyondsolo.overflowing_grace.desc": "every 6 s you heal the players within 10 blocks; healing past full health becomes a shield (up to 3 hearts)",
  "perk.beyondsolo.windwalker": "Windwalker",
  "perk.beyondsolo.windwalker.desc": "your arrows hit 20% harder beyond 20 blocks; after a combat roll or 2 s of sprinting your next arrow flies 40% harder, always critical",
  "passive.beyondsolo.ruin": "Ruin",
  "passive.beyondsolo.ruin.desc": "Every melee hit marks a foe; the fifth mark detonates in fire around it",
  "passive.beyondsolo.vanishing_edge": "Vanishing Edge",
  "passive.beyondsolo.vanishing_edge.desc": "A kill hides you for 3 s; your next strike within 5 s hits 80% harder",
  "passive.beyondsolo.insatiable": "Insatiable",
  "passive.beyondsolo.insatiable.desc": "Each kill feeds it for 30 s, up to 10: +3% spell damage for every kill fed",
  "passive.beyondsolo.unyielding": "Unyielding",
